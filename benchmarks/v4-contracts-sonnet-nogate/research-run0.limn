cite "12% increase in median CPU on routing nodes" from halverson-roy-2025
cite "71.2% (greedy-nearest baseline) to 83.6% (learned-policy)" from halverson-roy-2025
cite "Failover-recovery time was unchanged across all four policies (median 1.7s, p99 4.2s)" from halverson-roy-2025
cite "Edge Systems Consortium grant ESC-2024-31" from halverson-roy-2025
cite "edge-cache-data.org/halverson-roy-2025" from halverson-roy-2025

