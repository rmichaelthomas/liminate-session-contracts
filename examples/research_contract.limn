show "=== Research session contract ==="

remember a source called inception-source with "Liminate is a prose-as-syntax programming language designed by Rob Thomas. The language has 35 reserved words."
remember a source called addendum-source with "The add verb appends an item to an existing list. Five live-value safety checks run at analyze time."

remember a claim called convergence-claim with "Liminate is a prose-as-syntax programming language designed by Rob Thomas."
remember a claim called add-verb-claim with "The add verb appends an item to an existing list. Five live-value safety checks run at analyze time."
remember a claim called drift-claim with "Liminate has fifty reserved words."

remember a list called sources-consulted with "none"
remember a list called claims-recorded with "none"

remember a value called verification-status with "pending"
remember a list called verification-divergences with "none"

when verification-status is equal to "mismatch"
  show "WARN: claim diverges from source — review verification-divergences"

when verification-status is equal to "match"
  show "OK: claim verified against source"

show "--- citing exact text against sources ---"
cite "prose-as-syntax" from inception-source
cite "Rob Thomas" from inception-source
cite "35 reserved words" from inception-source
cite "live-value safety checks" from addendum-source

show "--- verifying claims against sources (structural) ---"
verify add-verb-claim from addendum-source

show "--- verifying a divergent claim (will flag) ---"
verify drift-claim from inception-source
show verification-divergences

show "--- recording verified claims ---"
add convergence-claim to claims-recorded
add add-verb-claim to claims-recorded

show "--- sources consulted ---"
add "inception" to sources-consulted
add "addendum-v1-add" to sources-consulted

show sources-consulted
show claims-recorded
count claims-recorded
